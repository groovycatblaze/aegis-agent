# LLM: simulated (offline default) | openai | anthropic
AEGIS_LLM_PROVIDER=simulated
AEGIS_LLM_MODEL=
# OpenAI-compatible endpoints (OpenAI, Azure OpenAI, Groq, Together, Ollama: http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# MCP transport: stdio (one subprocess per server) | memory
AEGIS_MCP_TRANSPORT=stdio

# Storage
AEGIS_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Retrieval: hashing (offline) | sentence-transformers
AEGIS_EMBEDDER=hashing
AEGIS_RERANKER=feature
AEGIS_TOP_K=4
